# ===== Laafi (CARFO Contentieux) — Fichier d'environnement exemple =====
# Copier ce fichier en '.env' et remplacer les valeurs avant de lancer 'docker compose up'.
# docker-compose.yml refuse de demarrer si DB_ROOT_PASSWORD, DB_PASSWORD ou JWT_SECRET
# sont absents : ce ne sont pas des valeurs par defaut a completer, ce sont des secrets
# que VOUS devez generer.
#
# Exemple de generation : openssl rand -base64 32

# ---------- Base de données MySQL (conteneur docker compose) ----------
DB_ROOT_PASSWORD=
DB_NAME=carfo_contentieux
DB_USERNAME=carfo
DB_PASSWORD=

# ---------- Authentification ----------
# Secret de signature des jetons JWT. Ne jamais reutiliser une valeur d'exemple trouvee
# dans un depot public. A generer avec: openssl rand -base64 48
JWT_SECRET=

# Cle de chiffrement (AES-256, 32 octets en base64) pour les champs sensibles (numero CNIB).
# A generer avec: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ---------- CORS ----------
# Origine(s) autorisee(s) a appeler l'API depuis un navigateur. En docker-compose, le
# frontend et l'API sont servis sous la meme origine via le proxy nginx (/api/), donc la
# valeur par defaut (http://localhost) suffit dans la plupart des cas.
CORS_ORIGINS=http://localhost
