# ===== CARFO Contentieux — Fichier d'environnement exemple =====
# Copier ce fichier en '.env' et adapter les valeurs avant de lancer 'docker compose up'
# (noms de variables alignés sur docker-compose.yml)

# ---------- Base de données MySQL (conteneur docker compose) ----------
DB_ROOT_PASSWORD=S3cur3_R00t_P4ss_W0rd
DB_NAME=carfo_contentieux
DB_USERNAME=carfo_app
DB_PASSWORD=S3cur3_Us3r_P4ss_W0rd

# Règle de validation du numéro de dossier (regex Java)
DOSSIER_NUMERO_REGEX=^DOS-[0-9]{4}-[0-9]{4,}$

# Limite de taille d'upload (en octets) — aligner avec nginx si besoin
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=20MB

# ---------- Frontend Angular / Nginx ----------
FRONT_PORT=8081
BACKEND_API_URL=http://backend:8080/api

# ---------- Actuator / Monitoring ----------
# Endpoints actuator exposés ; health/public, les autres nécessitent CHEF_SERVICE
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
